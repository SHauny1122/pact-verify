# Copy to .env.local. Use only credentials from a PayPal Sandbox REST app.
PAYPAL_ENVIRONMENT=sandbox
# Public client ID is required by PayPal JavaScript SDK v6.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Server only. Never prefix the secret with NEXT_PUBLIC_.
PAYPAL_CLIENT_SECRET=
# Server only. Create an API key in Google AI Studio.
GEMINI_API_KEY=
# Server only: Supabase Postgres transaction pooler URL (port 6543).
DATABASE_URL=
# Server only: connected PRIVATE Vercel Blob store token for proof videos.
BLOB_READ_WRITE_TOKEN=
# Capture is disabled by default. Enable only for a chosen controlled Sandbox case.
VERIFY_CAPTURE_ENABLED=false
# Capture requires this exact Verify session ID as well as the enabled flag.
VERIFY_CAPTURE_SESSION_ID=
